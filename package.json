{
  "name": "ai-knowledge-base",
  "version": "1.0.0",
  "description": "AI 学习知识库",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "npm run docs:dev",
    "docs:prepare": "node scripts/generate-access-config.mjs && node scripts/generate-practice-cases.mjs",
    "docs:dev": "npm run docs:prepare && vitepress dev docs",
    "docs:build": "npm test && vitepress build docs && node scripts/check-practice-cases.mjs && node scripts/check-site-links.mjs",
    "pretest": "npm run docs:prepare",
    "test": "node --test tests/*.test.mjs",
    "docs:check": "npm run docs:build",
    "docs:preview": "vitepress preview docs",
    "sync:hot": "node scripts/sync-aihot.mjs",
    "sync:leaderboard": "node scripts/sync-leaderboard.mjs",
    "cases:generate": "node scripts/generate-practice-cases.mjs"
  },
  "keywords": [],
  "author": "William",
  "license": "UNLICENSED",
  "devDependencies": {
    "vitepress": "^1.6.4"
  },
  "dependencies": {
    "medium-zoom": "^1.1.0"
  }
}
